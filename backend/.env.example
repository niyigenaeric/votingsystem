PORT=5000
NODE_ENV=development
JWT_SECRET=REPLACE_WITH_OUTPUT_FROM_CRYPTO_RANDOM_BYTES
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=voting_app
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_NAME=voting_system
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CA_CERT=
ALLOWED_EMAIL_DOMAINS=gmail.com,hotmail.com,outlook.com,yahoo.com,live.com,icloud.com
REQUIRE_VOTER_EMAIL_CONFIRMATION=true
REQUIRE_VOTER_LOGIN_CODE=true

# Configure account confirmation links and administrator/student email delivery.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_BASE_URL=http://localhost:5000

# Render production deployment needs values here, not in committed files.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=UR Voting System
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# In production, point this at a persistent volume, not the app container filesystem.
UPLOAD_DIR=
# Set to the number of trusted reverse-proxy hops in production.
TRUST_PROXY_HOPS=0
