PORT=5000
NODE_ENV=development
JWT_SECRET=REPLACE_WITH_OUTPUT_FROM_CRYPTO_RANDOM_BYTES
DB_HOST=127.0.0.1
DB_USER=voting_app
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_NAME=voting_system
ALLOWED_EMAIL_DOMAINS=gmail.com,hotmail.com,outlook.com,yahoo.com,live.com,icloud.com

# Configure for administrator OTP and student activation delivery.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# In production, point this at a persistent volume, not the app container filesystem.
UPLOAD_DIR=
# Set to the number of trusted reverse-proxy hops in production.
TRUST_PROXY_HOPS=0
